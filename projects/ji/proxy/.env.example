# Copy this to `.env` (which is gitignored) and fill it in. Never commit `.env`.

ANYTHINGLLM_KEY=your-anythingllm-key
PROXY_TOKEN=a-strong-shared-token

# Optional — sensible defaults if omitted:
# ANYTHINGLLM_URL=http://localhost:3001
# PORT=3017
# ALLOWED_ORIGIN=*
# CLOUDFLARED=/usr/local/opt/cloudflared/bin/cloudflared

# Optional hook run whenever the tunnel address changes. It can read $URL — the new
# public address — and push it to your fixed pointer (a GitHub Gist, ji's static host…).
# PUBLISH_URL_CMD=./publish-url.sh
