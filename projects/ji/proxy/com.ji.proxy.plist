<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd job for the thin proxy + tunnel. Copy to ~/Library/LaunchAgents/ and load it
     (see README). It runs run.sh at login and restarts it if it stops. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.ji.proxy</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/sand/GitHub/mono/ji/proxy/run.sh</string>
	</array>

	<key>WorkingDirectory</key>
	<string>/Users/sand/GitHub/mono/ji/proxy</string>

	<key>RunAtLoad</key>
	<true/>

	<key>KeepAlive</key>
	<true/>

	<key>StandardOutPath</key>
	<string>/Users/sand/GitHub/mono/ji/proxy/run.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/sand/GitHub/mono/ji/proxy/run.log</string>
</dict>
</plist>
